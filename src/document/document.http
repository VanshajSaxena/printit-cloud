### 

@base_url = http://{{hostname}}:{{port}}/api/v1
@documentId = 1
@documentName = Final Year Dissertation
@documentPath = /documents/final-year-dissertation.pdf
@hostname = localhost
@port = 3000


### Create a new document

POST {{base_url}}/documents HTTP/1.1
Content-Type: application/json

{
  "documents": [
    {
      "contentType": "application/pdf",
      "filename": "Final Year Dissertation",
      "draftId": "alsdoiafalksdf"
    }
  ]
}


### Get all documents

GET {{base_url}}/documents HTTP/1.1


### Get a single document by ID

GET {{base_url}}/documents/{{documentId}} HTTP/1.1


### Update an existing document

PATCH {{base_url}}/documents/{{documentId}} HTTP/1.1
Content-Type: application/json

{
  "name": "My updated document",
  "path": "/documents/my--document.pdf"
}


### Delete a document

DELETE {{base_url}}/documents/3 HTTP/1.1
