### 

@base_url = http://{{hostname}}:{{port}}/api/v1
@hostname = localhost
@port = 3000


### Create a new job

POST {{base_url}}/jobs HTTP/1.1
Content-Type: application/json

{
  "description": "This is a sample job description",
  "salary": 50000,
  "title": "Sample Job"
}


### Get all jobs

GET {{base_url}}/jobs HTTP/1.1


### Get a single job by ID

GET {{base_url}}/jobs/1 HTTP/1.1


### Update an existing job

PATCH {{base_url}}/jobs/1 HTTP/1.1
Content-Type: application/json

{
  "status": "COMPLETED"
}


### Update status of an existing job

PATCH {{base_url}}/jobs/1/status HTTP/1.1
Content-Type: application/json

{
  "status": "COMPLETED"
}


### Delete a job

DELETE {{base_url}}/jobs/1 HTTP/1.1
