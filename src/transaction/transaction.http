### 

@base_url = http://{{hostname}}:{{port}}/api/v1
@hostname = localhost
@port = 3000
@transactionId = 5
@vendorId = 1


### Create a new transaction

POST {{base_url}}/transactions HTTP/1.1
Content-Type: application/json

{
  "jobs": [
    {
      "copyCount": 1,
      "documentId": 2,
      "outputColor": "COLOR"
    }
  ],
  "vendorId": 1
}


### Get all transactions

GET {{base_url}}/transactions HTTP/1.1


### Get a single transaction by ID

GET {{base_url}}/transactions/{{transactionId}} HTTP/1.1


### Update an existing transaction

PATCH {{base_url}}/transactions/{{transactionId}} HTTP/1.1
Content-Type: application/json

{
  "printDocumentIds": [
    1,
    2
  ],
  "vendorId": 1
}


### Delete a transaction

DELETE {{base_url}}/transactions/{{transactionId}} HTTP/1.1
