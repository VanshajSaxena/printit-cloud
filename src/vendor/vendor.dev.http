### 

@base_url = https://{{hostname}}:{{port}}/api/v1
@hostname = dev.api.printit.ink
@port = 443


### Create a new vendor

POST {{base_url}}/vendors HTTP/1.1
Content-Type: application/json

{
  "email": "sayhi@vanshajsaxena.com",
  "firstName": "Vanshaj",
  "lastName": "Saxena",
  "username": "vanshaj"
}


### Get all vendors

GET {{base_url}}/vendors HTTP/1.1


### Get nearyby vendors

GET {{base_url}}/vendors/nearby?lat=0.0&lng=0.0&range=5000 HTTP/1.1


### Get a single vendor by ID

GET {{base_url}}/vendors/@harrypotter HTTP/1.1


### Update an existing vendor

PATCH {{base_url}}/vendors/1 HTTP/1.1
Content-Type: application/json

{
  "latitude": 0.0,
  "longitude": 0.0
}


### Delete a vendor

DELETE {{base_url}}/vendors/1 HTTP/1.1
