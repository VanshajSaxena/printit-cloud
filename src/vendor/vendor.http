@base_url = http://{{hostname}}:{{port}}/api/v1
@email = harshit@gmail.com
@firstname = Harshit
@hostname = localhost
@lastname = Shop
@port = 3000
@sub = 1234241234
@vendorId = 1


### Create a new vendor

POST {{base_url}}/vendors HTTP/1.1
Content-Type: application/json

{
  "email": "{{email}}",
  "firstname": "{{firstname}}",
  "lastname": "{{lastname}}",
  "sub": "{{sub}}"
}


### Get all vendors

GET {{base_url}}/vendors HTTP/1.1


### Get a single vendor by ID

GET {{base_url}}/vendors/{{vendorId}} HTTP/1.1


### Update an existing vendor

PATCH {{base_url}}/vendors/{{vendorId}} HTTP/1.1
Content-Type: application/json

{
  "email": "{{email}}",
  "firstname": "{{firstname}}",
  "lastname": "{{lastname}}",
  "sub": "{{sub}}"
}


### Delete a vendor

DELETE {{base_url}}/vendors/{{vendorId}} HTTP/1.1
