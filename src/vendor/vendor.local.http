### 

@base_url = http://{{hostname}}:{{port}}/api/v1
@hostname = localhost
@port = 3000


### Create a new vendor

POST {{base_url}}/vendors HTTP/1.1
Content-Type: application/json

{
  "email": "asfy@aisdfl.com",
  "firstName": "Harry",
  "lastName": "Potter",
  "latitude": 0.0,
  "longitude": 0.0,
  "username": "psjt2adlkfr"
}


### Get all vendors

GET {{base_url}}/vendors HTTP/1.1


### Get nearby vendors

GET {{base_url}}/vendors/nearby?lat=0.0&lng=0.0&range=500000 HTTP/1.1


### Get a single vendor by ID

GET {{base_url}}/vendors/@harrypotter HTTP/1.1


### Update an existing vendor

PATCH {{base_url}}/vendors/1 HTTP/1.1
Content-Type: application/json

{
  "email": "harry@potter.com",
  "firstName": "Harry",
  "lastName": "Potter"
}


### Delete a vendor

DELETE {{base_url}}/vendors/1 HTTP/1.1
